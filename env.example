PORT=3000
MONGODB_URI=mongodb://localhost:27017/women_help_api_db
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
OTP_EXPIRES_IN=5m
TEMP_TOKEN_EXPIRES_IN=2m

# SSO (Google Sign-In / Sign in with Apple)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
APPLE_BUNDLE_ID=

# Email Configuration (Nodemailer - Legacy)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com

# SendGrid Configuration (Currently Used)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your_verified_sender_email@domain.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_MERCHANT_DISPLAY_NAME=women-help-api
STRIPE_RETURN_URL=women-help-api://stripe-redirect

# App update prompts (GET /api/app/version — no auth required)
# Raise latest* when publishing; raise min* to force users below that build to update.
APP_ANDROID_MIN_VERSION_CODE=40
APP_ANDROID_LATEST_VERSION_CODE=41
APP_ANDROID_MIN_VERSION_NAME=1.1.23
APP_ANDROID_LATEST_VERSION_NAME=1.1.23
APP_IOS_MIN_VERSION=1.1.6
APP_IOS_LATEST_VERSION=1.2.7
APP_IOS_MIN_BUILD_NUMBER=1
APP_IOS_LATEST_BUILD_NUMBER=1
APP_RELEASE_NOTES_EN=A new version of women-help-api is available with improvements.
APP_RELEASE_NOTES_DE=Eine neue Version von women-help-api mit Verbesserungen ist verfügbar.
